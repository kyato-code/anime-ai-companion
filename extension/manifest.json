{
  "manifest_version": 3,
  "name": "Anime AI Companion",
  "version": "1.0.0",
  "description": "Live2D Anime Mascot dengan Interaksi Mouse dan AI Agent",
  "action": {
    "default_popup": "index.html",
    "default_title": "Anime AI Companion"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*"
  ]
}
